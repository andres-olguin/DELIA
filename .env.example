# Copy to .env for local development only; never commit real secrets.
# DANREXO naming is selected but GitHub repo retains historical DELIA route.
POSTGRES_USER=delia_local
POSTGRES_PASSWORD=SET_A_UNIQUE_RANDOM_LOCAL_PASSWORD
POSTGRES_DB=delia_local
# Set DANREXO_DATABASE_URL in the shell or deployment secret manager before
# using database-backed services. Do not put real credentials in this file.
# Example for a local, intentionally isolated SQLite test session:
# DANREXO_DATABASE_URL=sqlite://
# No public gateway, authentication or customer-data processing is enabled yet.
